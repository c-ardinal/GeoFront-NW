# Front reverse proxy: the only service published beyond localhost.
#   :8080 -> published on ${OBS_BIND}:${OBS_PORT} (default 127.0.0.1:8080): command-center at /,
#            the login screen (Authelia) at /auth/ when authentication is on
#   :9090 -> 127.0.0.1 only: Prometheus UI, read-only (the admin API used by `tools backup` is never proxied)
#   :80   -> not published: the container's own health check (and `tools check`)
# Access mode (OBS_ACCESS, set by the proxy's entrypoint in compose.yaml from OBS_BIND / OBS_AUTH, never by hand):
#   open  127.0.0.1 without authentication (the demo default): plain HTTP, no login, writes allowed by mask-api as "local"
#   auth  always on a LAN exposure, or OBS_AUTH=1: HTTPS from Caddy's own CA (tls internal; plain HTTP on the same port is
#         redirected to HTTPS), every request but the login screen first asked of Authelia (forward_auth). Authelia down,
#         slow or unreachable -> 502 / 504: nothing is served without a verified login (fail closed).
# The mode's parts are in access-<mode>-global.caddy (global options) and access-<mode>.caddy (snippets).
# Host allowlist (DNS rebinding): the screens answer only for the names they are really opened with, {$OBS_SITES}, built
# by the entrypoint (open: 127.0.0.1 / localhost / [::1] + OBS_PUBLIC_URL's host + the bind address; auth: OBS_PUBLIC_URL's
# host + the bind address). Any other Host gets 421 from the catch-all below (over HTTPS a name the CA did not certify
# fails already in the TLS handshake): no screen, no masked data, no writes.
{
	admin off
	import /etc/caddy/access-{$OBS_ACCESS}-global.caddy
}

import /etc/caddy/access-{$OBS_ACCESS}.caddy

# mask-api: with the proxy's key, so mask-api believes the identity headers set above only from here (mask_api.identity)
(mask_api) {
	reverse_proxy mask-api:8000 {
		header_up X-Obs-Auth "{$OBS_AUTH_PROXY_KEY}"
		{block}
	}
}

{$OBS_SITES} {
	import site_tls
	# Everything in written order: first the identity (client copies of the identity headers removed, then the login
	# check and the verified user / role in access-<mode>.caddy), then the routes.
	route {
		import identity

		handle /obs/exposure.json {
			header Content-Type application/json
			header Cache-Control no-store
			respond `\{"bind":"{$OBS_BIND:127.0.0.1}","access":"{$OBS_ACCESS}"\}` 200
		}
		# profile / flow source / inventory device names for the command-center (written by the setup step)
		handle /obs/config.json {
			root * /srv/obs-generated/ui
			rewrite * /config.json
			header Cache-Control no-store
			file_server
		}
		handle /healthz {
			respond "ok" 200
		}
		import login_portal
		# Writes (silences / ACK, pcap upload / delete, the evidence export with a snapshot): with authentication only for
		# a verified operator / admin (X-Obs-Role set above); mask-api checks each write again (role from the proxy only,
		# same origin, X-Obs-Csrf header, allowlists, sizes).
		@viewerWrite {
			not method GET HEAD
			path /am/* /pcap/* /evidence/*
			expression `"{$OBS_ACCESS}" != "open"`
			not header_regexp X-Obs-Role ^(operator|admin)$
		}
		handle @viewerWrite {
			header Content-Type application/json
			respond `\{"status":"error","errorType":"forbidden","error":"この操作には operator 以上の役割が必要です"\}` 403
		}
		# Alerts / silences for the command-center, through mask-api: reads are masked like /prom/ and /loki/; the only
		# writes are creating / extending / expiring silences (ACK).
		handle /am/* {
			import mask_api
		}
		# Packet analysis for the command-center, through mask-api (pcap_api.py): reads (file list, packets, details, hex,
		# statistics, filter checks) are masked; the only writes are uploading / deleting an uploaded pcap (same origin +
		# X-Obs-Csrf, rate limit, size / magic bytes). The size cap is in MiB, as in mask-api.
		handle /pcap/* {
			request_body {
				max_size {$PCAP_UPLOAD_MAX_MB:50}MiB
			}
			import mask_api
		}
		# Evidence export (mask-api evidence.py): GET / HEAD, plus one POST: the same export with the browser's screen
		# snapshot (PNG body, cap in MiB as in mask-api). The zip is assembled by mask-api from its own masked read paths;
		# it limits the window / rows / lines / bytes / time itself, runs one export at a time and a few per minute (429).
		handle /evidence/* {
			@evidenceWrite {
				not method GET HEAD
				not {
					method POST
					path /evidence/export
				}
			}
			header @evidenceWrite Content-Type application/json
			respond @evidenceWrite `\{"status":"error","error":"read-only (POST only to /evidence/export, with a snapshot)"\}` 405
			request_body {
				max_size {$EVIDENCE_SNAPSHOT_MAX_MB:8}MiB
			}
			# above mask-api's export time budget (EVIDENCE_TIME_BUDGET, 60 s): the zip, or its own error, always arrives;
			# a client that gives up closes the upstream connection and mask-api abandons the export (its slot is freed)
			import mask_api {
				transport http {
					response_header_timeout 90s
				}
			}
		}
		# 原因候補 (mask-api correlate.py): read-only, GET / HEAD only
		handle /correlate/* {
			@correlateWrite not method GET HEAD
			header @correlateWrite Content-Type application/json
			respond @correlateWrite `\{"status":"error","error":"read-only"\}` 405
			import mask_api {
				transport http {
					response_header_timeout 30s
				}
			}
		}
		# 推移 / ログ検索 (F1, mask-api trend_api.py / logsearch.py): read-only, GET / HEAD only; PromQL and LogQL are built
		# there from allowlisted parameters, never taken from the client
		@search path /trend/* /logsearch/*
		handle @search {
			@searchWrite not method GET HEAD
			header @searchWrite Content-Type application/json
			respond @searchWrite `\{"status":"error","error":"read-only"\}` 405
			import mask_api {
				transport http {
					response_header_timeout 30s
				}
			}
		}
		handle {
			reverse_proxy command-center:80
		}
	}
}

# Host not in the allowlist: nothing
{$OBS_CATCHALL} {
	import site_tls
	respond "misdirected request: open the screens with OBS_PUBLIC_URL" 421
}

# the container's health check and `tools check` (internal only, not published)
http://:80 {
	handle /healthz {
		respond "ok" 200
	}
	respond "misdirected request" 421
}

http://127.0.0.1:9090, http://localhost:9090, http://[::1]:9090 {
	@admin path /api/v1/admin/*
	respond @admin "forbidden" 403
	@write {
		not method GET HEAD
		not path /api/v1/query /api/v1/query_range /api/v1/series /api/v1/labels /api/v1/query_exemplars /api/v1/format_query /api/v1/parse_query
	}
	respond @write "forbidden" 403
	reverse_proxy prometheus:9090
}

http://:9090 {
	respond "misdirected request" 421
}
