# Front reverse proxy: the only service published beyond localhost.
#   :80   -> published on ${OBS_BIND}:${OBS_PORT} (default 127.0.0.1:8080): command-center at /, Grafana at /grafana/
#   :9090 -> 127.0.0.1 only: Prometheus UI, read-only (the admin API used by `tools backup` is never proxied)
#   :3000 -> 127.0.0.1 only: old Grafana URLs, redirected to /grafana/
# Host allowlist (DNS rebinding): every site answers only for the names the screens are really opened with. :80 =
# {$OBS_SITES}, built by the proxy's entrypoint (compose.yaml) from 127.0.0.1 / localhost / [::1], the host of
# OBS_PUBLIC_URL and the LAN bind address. Any other Host (e.g. an attacker's name pointed at 127.0.0.1) gets 421 from
# the catch-all blocks below: no screen, no masked data, no writes. LAN users open OBS_PUBLIC_URL.
{
	admin off
	auto_https off
}

{$OBS_SITES:http://127.0.0.1:80, http://localhost:80, http://[::1]:80} {
	# A role / user header only ever comes from the auth layer below, never from the client.
	request_header -X-Obs-Role
	request_header -X-Obs-User

	# ---- authentication insertion point (P1: no authentication) -------------------------------------
	# Put a forward-auth provider (Authelia, authentik, oauth2-proxy, ...) on the compose network and enable:
	#
	# forward_auth authelia:9091 {
	# 	uri /api/authz/forward-auth
	# 	copy_headers Remote-User Remote-Groups
	# }
	# @admins header Remote-Groups *obs-admin*
	# request_header @admins X-Obs-Role admin
	# request_header X-Obs-User {http.request.header.Remote-User}   # operator name in ACK comments / createdBy
	#
	# mask-api reads X-Obs-Role (today it always treats the request as viewer and keeps masking on; with
	# OBS_OPS_TRUST_ROLE=1 operator / admin may write silences, see /am/ below).
	# Grafana can trust the same identity with GF_AUTH_PROXY_ENABLED / GF_AUTH_PROXY_HEADER_NAME=Remote-User.
	# ---------------------------------------------------------------------------------------------------

	handle /obs/exposure.json {
		header Content-Type application/json
		header Cache-Control no-store
		respond `\{"bind":"{$OBS_BIND:127.0.0.1}"\}` 200
	}
	# profile / flow source / inventory device names for the command-center (written by the setup step)
	handle /obs/config.json {
		root * /srv/obs-generated/ui
		rewrite * /config.json
		header Cache-Control no-store
		file_server
	}
	handle /healthz {
		respond "ok" 200
	}
	# Alerts / silences for the command-center, through mask-api: reads are masked like /prom/ and /loki/; the only
	# writes are creating / extending / expiring silences (ACK). mask-api checks each write (allowlist, same origin,
	# X-Obs-Csrf header, matchers and duration). Writes are refused here as well while the screens are on the LAN: there
	# is no authentication yet. An authentication layer above may open them for X-Obs-Role operator / admin instead:
	# replace @amLanWrite with a check of that role and set OBS_OPS_TRUST_ROLE=1 for mask-api.
	handle /am/* {
		@amLanWrite {
			not method GET HEAD
			expression `!("{$OBS_BIND:127.0.0.1}".startsWith("127.") || "{$OBS_BIND:127.0.0.1}" == "localhost")`
		}
		header @amLanWrite Content-Type application/json
		respond @amLanWrite `\{"status":"error","errorType":"forbidden","error":"LAN 公開中は抑止・確認の操作はできません (認証がありません)"\}` 403
		reverse_proxy mask-api:8000
	}
	# Packet analysis for the command-center, through mask-api (pcap_api.py): reads (file list, packets, details, hex,
	# statistics, filter checks) are masked; the only writes are uploading / deleting an uploaded pcap, checked by
	# mask-api like the silences (same origin + X-Obs-Csrf, rate limit, size / magic bytes) and refused here as well
	# while the screens are on the LAN.
	handle /pcap/* {
		@pcapLanWrite {
			not method GET HEAD
			expression `!("{$OBS_BIND:127.0.0.1}".startsWith("127.") || "{$OBS_BIND:127.0.0.1}" == "localhost")`
		}
		header @pcapLanWrite Content-Type application/json
		respond @pcapLanWrite `\{"status":"error","errorType":"forbidden","error":"LAN 公開中は pcap のアップロード・削除はできません (認証がありません)"\}` 403
		request_body {
			max_size {$PCAP_UPLOAD_MAX_MB:50}MB
		}
		reverse_proxy mask-api:8000
	}
	redir /grafana /grafana/ 308
	handle /grafana/* {
		# Published beyond localhost, every /grafana/ request is first asked of `grafana-guard` (internal network only):
		# it answers 200 only while its last check of grafana.db was positive (no admin with a default password) and at
		# most two check intervals old. 403 from the guard is passed to the client; a stopped, frozen or slow guard means
		# no answer within 2 s -> 502 / 504. Fail closed by construction. On 127.0.0.1 nothing is asked.
		@onLan expression `!("{$OBS_BIND:127.0.0.1}".startsWith("127.") || "{$OBS_BIND:127.0.0.1}" == "localhost")`
		forward_auth @onLan grafana-guard:8099 {
			uri /allow
			transport http {
				dial_timeout 2s
				response_header_timeout 2s
			}
		}
		reverse_proxy grafana:3000
	}
	handle {
		reverse_proxy command-center:80
	}
}

# Host not in the allowlist: nothing (the health check of `tools check` stays answerable)
:80 {
	handle /healthz {
		respond "ok" 200
	}
	respond "misdirected request: open the screens with OBS_PUBLIC_URL (or 127.0.0.1)" 421
}

http://127.0.0.1:9090, http://localhost:9090, http://[::1]:9090 {
	@admin path /api/v1/admin/*
	respond @admin "forbidden" 403
	@write {
		not method GET HEAD
		not path /api/v1/query /api/v1/query_range /api/v1/series /api/v1/labels /api/v1/query_exemplars /api/v1/format_query /api/v1/parse_query
	}
	respond @write "forbidden" 403
	reverse_proxy prometheus:9090
}

:9090 {
	respond "misdirected request" 421
}

http://127.0.0.1:3000, http://localhost:3000, http://[::1]:3000 {
	handle /grafana/* {
		reverse_proxy grafana:3000
	}
	handle {
		redir * /grafana{uri} 302
	}
}

:3000 {
	respond "misdirected request" 421
}
