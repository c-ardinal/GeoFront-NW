# OBS_ACCESS=auth: every request is asked of Authelia (forward_auth, recipe of authelia.com/integration/proxies/caddy,
# subpath variant) except the login screen itself (/auth/) and /healthz. Fail closed: Authelia stopped, slow or
# unreachable -> 502 / 504, a request without a valid session -> Authelia's 302 to the login screen (or 401).
# Roles = Authelia groups viewer / operator / admin (users without one of them are refused by Authelia's access rules).

(site_tls) {
	tls internal
}

(identity) {
	# client copies first: neither the identity headers nor Authelia's own ever come from a client
	request_header -X-Obs-User
	request_header -X-Obs-Role
	request_header -X-Obs-Auth
	request_header -Remote-User
	request_header -Remote-Groups
	request_header -Remote-Email
	request_header -Remote-Name
	@protected not path /auth /auth/* /healthz
	forward_auth @protected authelia:9091 {
		uri /auth/api/authz/forward-auth
		copy_headers Remote-User Remote-Groups
		transport http {
			dial_timeout 2s
			response_header_timeout 5s
		}
	}
	# the verified user and the highest of its roles (Remote-Groups is Authelia's comma-separated group list)
	request_header @protected X-Obs-User {http.request.header.Remote-User}
	request_header @protected X-Obs-Role viewer
	@roleOperator {
		not path /auth /auth/* /healthz
		header_regexp Remote-Groups (^|,)\s*operator\s*(,|$)
	}
	request_header @roleOperator X-Obs-Role operator
	@roleAdmin {
		not path /auth /auth/* /healthz
		header_regexp Remote-Groups (^|,)\s*admin\s*(,|$)
	}
	request_header @roleAdmin X-Obs-Role admin
}

# the login screen (Authelia's portal, served under /auth/ on the screens' own origin: its session cookie is Secure,
# HttpOnly, SameSite and only for this host)
(login_portal) {
	@portal path /auth /auth/*
	handle @portal {
		reverse_proxy authelia:9091 {
			transport http {
				dial_timeout 2s
			}
		}
	}
}
