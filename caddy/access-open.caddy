# OBS_ACCESS=open: 127.0.0.1 without authentication (the demo default). No login screen, no identity: a role / user header
# only ever comes from the auth mode below, never from a client.

(site_tls) {
}

(identity) {
	request_header -X-Obs-User
	request_header -X-Obs-Role
	request_header -X-Obs-Auth
	request_header -Remote-User
	request_header -Remote-Groups
	request_header -Remote-Email
	request_header -Remote-Name
}

(login_portal) {
}
