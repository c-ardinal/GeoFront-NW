# Copy to .env and change, or let `docker compose run --rm tools init` write it. Do not commit .env.
# Without .env everything falls back to the defaults below (demo needs `--profile demo`; Grafana admin
# password "admin", forced to change on first login; everything bound to 127.0.0.1 only).

# ---- profile ----------------------------------------------------------------------------------
# Lets `docker compose up -d` pick the profile without --profile: demo | prod (tools init writes prod)
# COMPOSE_PROFILES=demo

# ---- exposure and login ------------------------------------------------------------------------
# Screens (command-center at /, Grafana at /grafana/). 127.0.0.1 = this host only, no login (the demo default).
# A LAN IP or 0.0.0.0 publishes them to the LAN, ALWAYS with a login (Authelia) over HTTPS (Caddy's own CA; plain HTTP
# on the same port is redirected). README "ログイン (認証)": secrets (tools init / tools user secrets), users (tools user add).
OBS_BIND=127.0.0.1
OBS_PORT=8080
# URL browsers use to open the screens (login, Grafana and notification links). With a login: https://<host's LAN IP>:<port>
# With a login the screens answer only for its host and the OBS_BIND address (without: also 127.0.0.1 / localhost / [::1]).
OBS_PUBLIC_URL=http://127.0.0.1:8080
# 1 = require the login on 127.0.0.1 as well (the LAN always requires it)
# OBS_AUTH=0
# Login secrets (generated by tools init / `docker compose run --rm tools user secrets`; never shown, never in the repo).
# Changing OBS_AUTH_STORAGE_KEY makes Authelia refuse its stored data (TOTP keys): keep it with the backups.
# OBS_AUTH_SESSION_SECRET=
# OBS_AUTH_STORAGE_KEY=
# OBS_AUTH_PROXY_KEY=
# session: ends after this much inactivity / at the latest after this long; "remember me" (0 = not offered, e.g. 7d)
# OBS_AUTH_INACTIVITY=30m
# OBS_AUTH_EXPIRATION=12h
# OBS_AUTH_REMEMBER_ME=0
# brute force: OBS_AUTH_MAX_RETRIES failed logins within OBS_AUTH_FIND_TIME (per user and per address) lock out for
# OBS_AUTH_BAN_TIME
# OBS_AUTH_MAX_RETRIES=5
# OBS_AUTH_FIND_TIME=10m
# OBS_AUTH_BAN_TIME=15m
# 1 = second factor (TOTP app) required for every user (README: registration)
# OBS_AUTH_TOTP=0
# with the login, Grafana (raw values: role admin only) trusts its auth proxy headers only from the proxy's fixed address
# on the internal network grafana-front; change both if this subnet is already used on the host
# OBS_GRAFANA_NET=172.31.253.0/29
# OBS_GRAFANA_NET_DYNAMIC=172.31.253.4/30
# OBS_GRAFANA_PROXY_IP=172.31.253.2
# Syslog receive address/port (UDP and TCP). 127.0.0.1 receives nothing from the LAN; set the host's LAN IP
# (or 0.0.0.0) so the routers / APs can send to it.
SYSLOG_BIND=127.0.0.1
SYSLOG_PORT=514
# 1 = drop syslog lines from senders that are not in the inventory (default: kept as host="unknown")
# SYSLOG_DROP_UNKNOWN=0
# localhost-only management views via the proxy: Prometheus (read-only) and the old Grafana URL
# PROM_LOCAL_PORT=9090
# GRAFANA_LOCAL_PORT=3000

# Grafana admin (Grafana's own login; with the screens' login Grafana takes its users from Authelia instead and has no
# login form). Applied on Grafana's first start only (later: change it in Grafana). tools init, and with the login also
# check / setup, refuse a default value.
GF_ADMIN_PASSWORD=change-me
# time zone of the tools container (backup file names)
# TZ=Asia/Tokyo

# ---- demo -------------------------------------------------------------------------------------
# 1 = cycle demo faults automatically (down / wanspike / logburst / counter_reset)
DEMO_AUTO_FAULTS=1
DEMO_AUTO_FAULT_INTERVAL=240

# ---- prod: devices and SNMP -------------------------------------------------------------------
OBS_INVENTORY=inventory/devices.yaml
# SNMPv3 authPriv (auth yamaha_v3). Protocols: SHA SHA224 SHA256 SHA384 SHA512 MD5 / AES AES192 AES256 AES192C AES256C DES
SNMP_V3_USER=
SNMP_V3_AUTH_PROTO=SHA
SNMP_V3_AUTH_PASS=
SNMP_V3_PRIV_PROTO=AES
SNMP_V3_PRIV_PASS=
# SNMPv2c (auth yamaha_v2c), only if a device cannot do v3. Leave empty otherwise.
SNMP_COMMUNITY=

# ---- notifications (alert notifications) ----------------------------------------------------------
# Destinations and routes per severity: alerting/receivers.yaml (copy alerting/receivers.example.yaml). Only the
# secrets / SMTP server go here. Nothing is sent anywhere unless receivers.yaml names a destination.
# After a change: docker compose up -d (regenerates), then docker compose run --rm tools notify-test
# OBS_RECEIVERS=alerting/receivers.yaml
# e-mail (type: email). SMTP_TLS: starttls (port 587) | tls (465) | none (25, unencrypted)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=starttls
# Slack Incoming Webhook URL (type: slack) / Discord webhook URL (type: discord)
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
# LINE Messaging API channel access token (long-lived) (type: line; the recipient ID is in receivers.yaml)
# LINE_CHANNEL_ACCESS_TOKEN=
# generic webhook (type: webhook): URL, optional bearer token
# WEBHOOK_URL=
# WEBHOOK_BEARER_TOKEN=
# Silence / ACK, pcap upload, evidence with a snapshot from the screens: with a login for the roles operator / admin;
# without one (127.0.0.1) for everyone on this host.
# Alertmanager keeps silences and its notification log this long
# ALERTMANAGER_RETENTION=168h

# ---- traffic surges (network map / 原因候補, README "ネットワーク図と相関") ------------------------------------
# A host x destination (country / ASN) is a surge when its last 5 min rate is >= SURGE_MIN_KBPS and more than
# SURGE_FACTOR x its own median over SURGE_BASELINE (1h .. 24h / 1d, ending 5 min ago). Applied by the setup step.
# SURGE_FACTOR=3
# SURGE_MIN_KBPS=200
# SURGE_BASELINE=1h

# ---- packet capture and analysis (README "パケット取込と解析") ----------------------------------------
# Capture is OFF by default. To turn it on (Linux host only; not Docker Desktop / WSL): COMPOSE_PROFILES=prod,capture,
# OBS_CAPTURE=1 and the interface that sees the LAN traffic (a mirror port is set up by hand on the switch / router:
# spec G4). Then: docker compose up -d ; docker compose run --rm tools capture status
# OBS_CAPTURE=0
# CAPTURE_IFACE=eth0
# BPF capture filter (tcpdump syntax), e.g. "not port 22" ; empty = everything
# CAPTURE_BPF=
# bytes kept per packet (headers + TLS SNI / DNS / HTTP Host need ~1514; smaller = less content kept)
# CAPTURE_SNAPLEN=1514
# ring buffer: CAPTURE_FILES files of CAPTURE_FILE_MB (dumpcap overwrites the oldest), a new file at least every
# CAPTURE_FILE_SECONDS (flows lag by about that much); ring files older than CAPTURE_KEEP_HOURS are deleted
# CAPTURE_FILE_MB=20
# CAPTURE_FILES=20
# CAPTURE_FILE_SECONDS=60
# CAPTURE_KEEP_HOURS=24
# LAN address ranges (comma separated): decides outbound / inbound; default = all private ranges
# OBS_LAN_CIDRS=192.168.100.0/24
# 1 = name hosts by reverse DNS when the inventory and DHCP give no name
# FLOWD_RDNS=0
# uploaded pcap / pcapng: per file, all uploads together, deleted after (hours)
# PCAP_UPLOAD_MAX_MB=50
# PCAP_UPLOADS_TOTAL_MB=200
# PCAP_KEEP_HOURS=24
# analysis limits: seconds per tshark run, runs at once, memory per run (MB), packets per list
# PCAP_ANALYZE_TIMEOUT=60
# PCAP_VALIDATE_TIMEOUT=180     # an upload is read to its end by tshark before it is accepted (else 413)
# PCAP_ANALYZE_CONCURRENCY=1
# (memory per run: ANALYZER_MEM must hold (PCAP_ANALYZE_CONCURRENCY + 1) x PCAP_ANALYZE_PROC_MB + ~60 MB)
# PCAP_ANALYZE_PROC_MB=384
# PCAP_MAX_PACKETS=100000
# analyses (packet lists, details, statistics, filter checks) per client and minute
# PCAP_READS_PER_MIN=120
# demo: flows from the bundled synthetic pcap replayed by flowd-demo (1, default) or demo-gen's counters (0); byte scale
# DEMO_PCAP_REPLAY=1
# DEMO_PCAP_SCALE=1500
# GeoIP: DB-IP Lite City + ASN (CC BY 4.0), monthly: docker compose run --rm tools geoip update

# ---- retention --------------------------------------------------------------------------------
PROM_RETENTION=30d
# 0 = no size limit; e.g. 8GB on a small SD card (oldest blocks go first)
PROM_RETENTION_SIZE=0
LOKI_RETENTION=720h

# ---- small host (Raspberry Pi) ------------------------------------------------------------------
# Grafana is optional: the command-center does not need it. 0 = no Grafana (saves ~100 MB and its
# background work; /grafana/ then answers 502). Recommended on a Raspberry Pi (README "Raspberry Pi").
# OBS_GRAFANA=1

# ---- resources (defaults sized for a Raspberry Pi 4, 4 GB) ------------------------------------
# PROM_MEM=512m
# PROM_CPUS=1.0
# LOKI_MEM=512m
# LOKI_CPUS=1.0
# ALLOY_MEM=256m
# ALLOY_CPUS=0.5
# GRAFANA_MEM=384m
# GRAFANA_CPUS=0.5
# SNMP_EXPORTER_MEM=96m
# MASK_API_MEM=320m
# ANALYZER_MEM=896m
# ANALYZER_CPUS=1.0
# FLOWD_MEM=192m
# CAPTURE_MEM=128m
# COMMAND_CENTER_MEM=64m
# PROXY_MEM=128m
# AUTHELIA_MEM=256m
# DEMO_GEN_MEM=128m
# ALERTMANAGER_MEM=64m
# NOTIFY_RELAY_MEM=64m
# container log rotation (json-file)
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=3
