# Copy to .env and change, or let `docker compose run --rm tools init` write it. Do not commit .env.
# Without .env everything falls back to the defaults below (demo needs `--profile demo`; Grafana admin
# password "admin", forced to change on first login; everything bound to 127.0.0.1 only).

# ---- profile ----------------------------------------------------------------------------------
# Lets `docker compose up -d` pick the profile without --profile: demo | prod (tools init writes prod)
# COMPOSE_PROFILES=demo

# ---- exposure (no authentication yet) ---------------------------------------------------------
# Screens (command-center at /, Grafana at /grafana/). 127.0.0.1 = this host only. A LAN IP or 0.0.0.0
# publishes them to the LAN WITHOUT authentication; the screen and the proxy log then warn about it.
OBS_BIND=127.0.0.1
OBS_PORT=8080
# URL browsers use to open the screens (Grafana builds absolute links from it). On the LAN: http://<host's LAN IP>:<port>
OBS_PUBLIC_URL=http://127.0.0.1:8080
# Syslog receive address/port (UDP and TCP). 127.0.0.1 receives nothing from the LAN; set the host's LAN IP
# (or 0.0.0.0) so the routers / APs can send to it.
SYSLOG_BIND=127.0.0.1
SYSLOG_PORT=514
# 1 = drop syslog lines from senders that are not in the inventory (default: kept as host="unknown")
# SYSLOG_DROP_UNKNOWN=0
# localhost-only management views via the proxy: Prometheus (read-only) and the old Grafana URL
# PROM_LOCAL_PORT=9090
# GRAFANA_LOCAL_PORT=3000

# Grafana admin. On the LAN (OBS_BIND not 127.x) Grafana requires a login, so this must not stay a default value
# (tools init / check refuse it). Applied on Grafana's first start only (later: change it in Grafana).
GF_ADMIN_PASSWORD=change-me
# 1 = keep Grafana's anonymous Viewer (no login) even on the LAN. Its panels show raw, unmasked IP / MAC values.
# OBS_GRAFANA_ANON_ON_LAN=0
# seconds between grafana-guard's checks of the stored Grafana admin passwords (LAN exposure of /grafana/)
# OBS_GRAFANA_GUARD_INTERVAL=60
# time zone of the tools container (backup file names)
# TZ=Asia/Tokyo

# ---- demo -------------------------------------------------------------------------------------
# 1 = cycle demo faults automatically (down / wanspike / logburst / counter_reset)
DEMO_AUTO_FAULTS=1
DEMO_AUTO_FAULT_INTERVAL=240

# ---- prod: devices and SNMP -------------------------------------------------------------------
OBS_INVENTORY=inventory/devices.yaml
# SNMPv3 authPriv (auth yamaha_v3). Protocols: SHA SHA224 SHA256 SHA384 SHA512 MD5 / AES AES192 AES256 AES192C AES256C DES
SNMP_V3_USER=
SNMP_V3_AUTH_PROTO=SHA
SNMP_V3_AUTH_PASS=
SNMP_V3_PRIV_PROTO=AES
SNMP_V3_PRIV_PASS=
# SNMPv2c (auth yamaha_v2c), only if a device cannot do v3. Leave empty otherwise.
SNMP_COMMUNITY=

# ---- retention --------------------------------------------------------------------------------
PROM_RETENTION=30d
# 0 = no size limit; e.g. 8GB on a small SD card (oldest blocks go first)
PROM_RETENTION_SIZE=0
LOKI_RETENTION=720h

# ---- resources (defaults sized for a Raspberry Pi 4, 4 GB) ------------------------------------
# PROM_MEM=768m
# PROM_CPUS=1.0
# LOKI_MEM=512m
# LOKI_CPUS=1.0
# ALLOY_MEM=256m
# ALLOY_CPUS=0.5
# GRAFANA_MEM=384m
# GRAFANA_CPUS=0.5
# SNMP_EXPORTER_MEM=96m
# MASK_API_MEM=128m
# COMMAND_CENTER_MEM=64m
# PROXY_MEM=128m
# DEMO_GEN_MEM=128m
# container log rotation (json-file)
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=3
