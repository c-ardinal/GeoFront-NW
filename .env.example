# Copy to .env and change. Do not commit .env.
# Without .env, compose falls back to "admin" (Grafana forces a change on first login;
# all ports are bound to 127.0.0.1 only).
GF_ADMIN_PASSWORD=change-me
# 1 = cycle demo faults automatically (down / wanspike / logburst / counter_reset)
DEMO_AUTO_FAULTS=1
DEMO_AUTO_FAULT_INTERVAL=240
