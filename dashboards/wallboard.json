{
  "uid": "yamaha-wallboard",
  "title": "DB01 Wallboard - YAMAHA Network Observatory (DEMO DATA)",
  "description": "DEMO: all metrics, flows and logs are synthetic, generated by demo-gen. Not observed reality.",
  "tags": ["yamaha", "wallboard", "demo"],
  "timezone": "Asia/Tokyo",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "15s",
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["15s", "30s", "1m"] },
  "schemaVersion": 41,
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "device",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(up{job=\"snmp\"}, instance)",
        "query": { "query": "label_values(up{job=\"snmp\"}, instance)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "multi": true,
        "includeAll": true,
        "current": { "text": ["All"], "value": ["$__all"] },
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "WAN Down", "description": "WAN interface of the inventory (demo: rtx1300 lan2; prod: wan_interface), recorded by Prometheus as obs_wan:ifHCInOctets:rate1m: 8 x rate / 1e6. No WAN configured = no data",
      "gridPos": { "x": 0, "y": 0, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "instant": true, "range": false,
        "expr": "sum(obs_wan:ifHCInOctets:rate1m and on (instance) (up{job=\"snmp\"} == 1)) * 8 / 1e6" }],
      "fieldConfig": { "defaults": { "unit": "suffix: Mbps", "decimals": 0, "noValue": "NO DATA / STALE",
        "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 800 }, { "color": "red", "value": 950 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["last"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value", "justifyMode": "center" }
    },
    {
      "id": 2, "type": "stat", "title": "WAN Up", "description": "WAN interface of the inventory (demo: rtx1300 lan2; prod: wan_interface), recorded by Prometheus as obs_wan:ifHCOutOctets:rate1m: 8 x rate / 1e6. No WAN configured = no data",
      "gridPos": { "x": 3, "y": 0, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "instant": true, "range": false,
        "expr": "sum(obs_wan:ifHCOutOctets:rate1m and on (instance) (up{job=\"snmp\"} == 1)) * 8 / 1e6" }],
      "fieldConfig": { "defaults": { "unit": "suffix: Mbps", "decimals": 0, "noValue": "NO DATA / STALE",
        "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }, { "color": "orange", "value": 800 }, { "color": "red", "value": 950 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["last"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value", "justifyMode": "center" }
    },
    {
      "id": 3, "type": "stat", "title": "Devices online", "description": "SNMP targets with up=1 / configured targets",
      "gridPos": { "x": 6, "y": 0, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "instant": true, "range": false, "legendFormat": "online", "expr": "sum(up{job=\"snmp\",instance=~\"$device\"})" },
        { "refId": "B", "instant": true, "range": false, "legendFormat": "of", "expr": "count(up{job=\"snmp\",instance=~\"$device\"})" }
      ],
      "fieldConfig": { "defaults": { "decimals": 0, "noValue": "NO DATA / STALE", "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": [{ "matcher": { "id": "byName", "options": "online" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }] },
      "options": { "reduceOptions": { "calcs": ["last"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name", "justifyMode": "center", "orientation": "horizontal" }
    },
    {
      "id": 4, "type": "stat", "title": "Firing alerts", "description": "Prometheus ALERTS{alertstate=firing}",
      "gridPos": { "x": 9, "y": 0, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "instant": true, "range": false, "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)" }],
      "fieldConfig": { "defaults": { "decimals": 0, "noValue": "NO DATA / STALE", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["last"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "center" }
    },
    {
      "id": 5, "type": "stat", "title": "Syslog events / 5m", "description": "Loki count_over_time over the last 5 minutes",
      "gridPos": { "x": 12, "y": 0, "w": 3, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "queryType": "instant", "expr": "sum(count_over_time({job=\"syslog\", host=~\"$device\"}[5m]))" }],
      "fieldConfig": { "defaults": { "decimals": 0, "noValue": "NO DATA / STALE", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }, { "color": "orange", "value": 3000 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["last"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value", "justifyMode": "center" }
    },
    {
      "id": 6, "type": "stat", "title": "Data freshness (worst)", "description": "Seconds since the last successful SNMP scrape of the stalest selected device. DOWN devices are included; no success in the last 15 min shows as > 15 min.",
      "gridPos": { "x": 15, "y": 0, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "instant": true, "range": false,
        "expr": "max((time() - max by (instance) ((timestamp(up{job=\"snmp\",instance=~\"$device\"}) and up{job=\"snmp\",instance=~\"$device\"} == 1) or max_over_time((timestamp(up{job=\"snmp\",instance=~\"$device\"}) and up{job=\"snmp\",instance=~\"$device\"} == 1)[15m:15s]))) or (max by (instance) (up{job=\"snmp\",instance=~\"$device\"}) * 0 + 900))" }],
      "fieldConfig": { "defaults": { "unit": "suffix: s", "decimals": 0, "noValue": "NO DATA / STALE", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 45 }, { "color": "red", "value": 120 }] },
        "mappings": [{ "type": "range", "options": { "from": 900, "to": null, "result": { "text": "> 15 min", "color": "red", "index": 0 } } }] }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["last"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value", "justifyMode": "center" }
    },
    {
      "id": 7, "type": "text", "title": "",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "options": { "mode": "markdown", "content": "### DEMO DATA / synthetic\ndemo-gen が生成した**疑似データ**です。実機 (RTX1300 / WLX413 / WLX222) の観測値ではありません。国・都市・座標は架空の GeoIP 推定値です。" }
    },
    {
      "id": 8, "type": "geomap",
      "title": "Destinations by GeoIP estimate (synthetic) - markers are estimated locations, NOT physical routes",
      "description": "Marker size/colour = bits/s over 5m. Locations are GeoIP *estimates* (fake in this demo); they are not routes, owners or real whereabouts. Unknown (no GeoIP) is not plotted - see Top destinations.",
      "gridPos": { "x": 0, "y": 4, "w": 16, "h": 11 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "instant": true, "range": false, "format": "table",
        "expr": "sum by (dst_country, dst_city, lat, lon, asn) (rate(obs_flow_bytes_total{lat!=\"\"}[5m])) * 8" }],
      "transformations": [
        { "id": "convertFieldType", "options": { "conversions": [
          { "targetField": "lat", "destinationType": "number" },
          { "targetField": "lon", "destinationType": "number" } ], "fields": {} } }
      ],
      "fieldConfig": { "defaults": { "unit": "bps", "noValue": "NO DATA / STALE", "color": { "mode": "continuous-GrYlRd" } }, "overrides": [] },
      "options": {
        "view": { "id": "coords", "lat": 30, "lon": 40, "zoom": 1.7, "allLayers": true },
        "controls": { "showZoom": false, "mouseWheelZoom": false, "showAttribution": true },
        "tooltip": { "mode": "details" },
        "basemap": { "type": "xyz", "name": "Basemap", "config": { "url": "https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}", "attribution": "Tiles &copy; Esri" } },
        "layers": [{
          "type": "markers", "name": "Destinations", "tooltip": true,
          "location": { "mode": "coords", "latitude": "lat", "longitude": "lon" },
          "config": {
            "showLegend": true,
            "style": {
              "size": { "field": "Value", "min": 5, "max": 30, "fixed": 5 },
              "color": { "field": "Value", "fixed": "green" },
              "opacity": 0.75,
              "symbol": { "mode": "fixed", "fixed": "img/icons/marker/circle.svg" },
              "text": { "mode": "field", "field": "dst_city", "fixed": "" },
              "textConfig": { "fontSize": 11, "offsetX": 0, "offsetY": -16, "textAlign": "center", "textBaseline": "middle" }
            }
          }
        }]
      }
    },
    {
      "id": 9, "type": "table", "title": "Device status",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "instant": true, "range": false, "format": "table", "expr": "max by (instance) (up{job=\"snmp\",instance=~\"$device\"})" },
        { "refId": "B", "instant": true, "range": false, "format": "table", "expr": "max by (instance) (sysUpTime{job=\"snmp\",instance=~\"$device\"}) / 100" },
        { "refId": "C", "instant": true, "range": false, "format": "table", "expr": "(time() - max by (instance) ((timestamp(up{job=\"snmp\",instance=~\"$device\"}) and up{job=\"snmp\",instance=~\"$device\"} == 1) or max_over_time((timestamp(up{job=\"snmp\",instance=~\"$device\"}) and up{job=\"snmp\",instance=~\"$device\"} == 1)[15m:15s]))) or (max by (instance) (up{job=\"snmp\",instance=~\"$device\"}) * 0 + 900)" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true },
          "indexByName": { "instance": 0, "Value #A": 1, "Value #B": 2, "Value #C": 3 },
          "renameByName": { "instance": "Device", "Value #A": "Status", "Value #B": "Uptime", "Value #C": "Last seen (s ago)" } } }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } }, "noValue": "STALE" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Status" }, "properties": [
            { "id": "mappings", "value": [
              { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 0 }, "0": { "text": "DOWN", "color": "red", "index": 1 } } },
              { "type": "special", "options": { "match": "null+nan", "result": { "text": "UNKNOWN", "color": "orange", "index": 2 } } } ] },
            { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } } ] },
          { "matcher": { "id": "byName", "options": "Uptime" }, "properties": [{ "id": "unit", "value": "dtdurations" }, { "id": "noValue", "value": "STALE" }] },
          { "matcher": { "id": "byName", "options": "Last seen (s ago)" }, "properties": [
            { "id": "unit", "value": "suffix: s" }, { "id": "decimals", "value": 0 },
            { "id": "mappings", "value": [{ "type": "range", "options": { "from": 900, "to": null, "result": { "text": "> 15 min", "color": "red", "index": 0 } } }] },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 45 }, { "color": "red", "value": 120 }] } },
            { "id": "custom.cellOptions", "value": { "type": "color-text" } } ] }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } }
    },
    {
      "id": 10, "type": "table", "title": "Top destinations by country (synthetic, Unknown included)",
      "description": "Share = country bytes / all flow bytes x 100; Unknown stays in the denominator (spec 05).",
      "gridPos": { "x": 16, "y": 9, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "instant": true, "range": false, "format": "table", "expr": "sum by (dst_country) (rate(obs_flow_bytes_total[5m])) * 8" },
        { "refId": "B", "instant": true, "range": false, "format": "table", "expr": "sum by (dst_country) (rate(obs_flow_bytes_total[5m])) / scalar(sum(rate(obs_flow_bytes_total[5m]))) * 100" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true },
          "renameByName": { "dst_country": "Country", "Value #A": "Rate", "Value #B": "Share" } } }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } }, "noValue": "NO DATA / STALE" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Rate" }, "properties": [{ "id": "unit", "value": "bps" }] },
          { "matcher": { "id": "byName", "options": "Share" }, "properties": [
            { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 }, { "id": "min", "value": 0 }, { "id": "max", "value": 100 },
            { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "basic" } }, { "id": "color", "value": { "mode": "continuous-BlPu" } } ] }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false }, "sortBy": [{ "displayName": "Rate", "desc": true }] }
    },
    {
      "id": 11, "type": "timeseries", "title": "WAN throughput (inventory WAN interface, Mbps fixed)",
      "description": "WAN interface of the inventory (legend: device and ifName; recorded as obs_wan:*). 8 x rate(ifHC*Octets[1m]) / 1e6. Gaps = no data (never filled with 0). Threshold line 800 Mbps = 80% of 1000 Mbps.",
      "gridPos": { "x": 0, "y": 15, "w": 16, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "{{instance}} {{ifName}} down (in)", "expr": "sum by (instance, ifName) (obs_wan:ifHCInOctets:rate1m and on (instance) (up{job=\"snmp\"} == 1)) * 8 / 1e6" },
        { "refId": "B", "legendFormat": "{{instance}} {{ifName}} up (out)", "expr": "sum by (instance, ifName) (obs_wan:ifHCOutOctets:rate1m and on (instance) (up{job=\"snmp\"} == 1)) * 8 / 1e6" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: Mbps", "min": 0, "decimals": 0,
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "orange", "value": 800 }, { "color": "red", "value": 950 }] },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "spanNulls": false, "showPoints": "never",
            "thresholdsStyle": { "mode": "line" }, "scaleDistribution": { "type": "linear" }, "axisSoftMax": 300 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "down (in)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "up (out)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 12, "type": "alertlist", "title": "Alerts (Prometheus rules)",
      "gridPos": { "x": 16, "y": 15, "w": 8, "h": 6 },
      "options": {
        "viewMode": "list", "groupMode": "default", "groupBy": [], "maxItems": 20, "sortOrder": 1,
        "dashboardAlerts": false, "alertName": "", "alertInstanceLabelFilter": "", "datasource": "Prometheus",
        "showInstances": true,
        "stateFilter": { "firing": true, "pending": true, "noData": false, "normal": false, "error": true, "recovering": true }
      }
    },
    {
      "id": 13, "type": "logs", "title": "Syslog (synthetic, latest 50)",
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "queryType": "range", "maxLines": 50, "expr": "{job=\"syslog\", host=~\"$device\"} | line_format \"{{.host}} [{{.severity}}] {{__line__}}\"" }],
      "options": { "showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": false, "prettifyLogMessage": false,
        "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" }
    }
  ]
}
