# Env file for trying the prod path against simulated devices, without hardware and without touching .env:
#   docker compose --env-file testbed/testbed.env up -d --build
#   docker compose --env-file testbed/testbed.env run --rm tools check
#   docker compose --env-file testbed/testbed.env down -v      (removes the testbed's own volumes only)
# Separate project name = separate volumes / generated targets; other host ports so it can run next to prod.
# The SNMP credentials below are DUMMY values shared by the simulator and snmp-exporter; never reuse them.
COMPOSE_PROJECT_NAME=yamaha-observatory-testbed
COMPOSE_PROFILES=prod,testbed
# repository files: absolute paths inside the tools container (/work = this repository), so they resolve also
# when OBS_CONFIG_DIR (mounted at /config) is set
OBS_INVENTORY=/work/testbed/devices.yaml
OBS_BIND=127.0.0.1
OBS_PORT=18080
OBS_PUBLIC_URL=http://127.0.0.1:18080
PROM_LOCAL_PORT=19090
SYSLOG_BIND=127.0.0.1
SYSLOG_PORT=10514
SNMP_V3_USER=obs-testbed
SNMP_V3_AUTH_PROTO=SHA
SNMP_V3_AUTH_PASS=testbed-auth-dummy
SNMP_V3_PRIV_PROTO=AES
SNMP_V3_PRIV_PASS=testbed-priv-dummy
SNMP_COMMUNITY=testbed-community-dummy
# Notifications: testbed/receivers.yaml, every destination is the notifymock service (DUMMY secrets, never real ones)
OBS_RECEIVERS=/work/testbed/receivers.yaml
SMTP_HOST=notifymock
SMTP_PORT=2525
SMTP_TLS=starttls
SMTP_TLS_VERIFY=0
SMTP_FROM=obs-testbed@example.com
SMTP_USER=testbed
SMTP_PASSWORD=testbed-smtp-dummy
SLACK_WEBHOOK_URL=http://notifymock:8080/slack/T000/B000/dummy
DISCORD_WEBHOOK_URL=http://notifymock:8080/discord/000/dummy
LINE_CHANNEL_ACCESS_TOKEN=testbed-line-dummy
LINE_API_URL=http://notifymock:8080/line/v2/bot/message/push
WEBHOOK_URL=http://notifymock:8080/hook
WEBHOOK_BEARER_TOKEN=testbed-hook-dummy
