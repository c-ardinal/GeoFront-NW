// Syslog (UDP + TCP 514) -> Loki.
//
// The listener runs in "raw" mode: Alloy decodes only the <PRI> (-> severity / facility labels) and keeps the
// rest of the line verbatim, so YAMAHA lines that have no timestamp, hostname or tag keep their first word
// (TC-003: the RFC3164 parser took "PP[01]" / "LAN2:" for a tag and cut it off). loki.process below then
// recognises RFC5424 and RFC3164 headers and strips them; anything else is the message as sent.
// "raw" is an experimental Alloy feature, hence --stability.level=experimental in compose.yaml.
//
// host label: taken from the source address only, never from the header hostname (anyone on the LAN can write
// any hostname into a header). The generated host map turns an inventory device's source IP / reverse-DNS name
// into its name; every other sender is host="unknown" with its address in the src_ip label (one value per
// sender, so the label set stays bounded). SYSLOG_DROP_UNKNOWN=1 drops those lines instead.
// A header hostname that differs from the device name is kept at the start of the message, so nothing is lost
// (also when a device omits the hostname and the first word of the message looked like one).
// Labels: job / host / severity / facility (what the command-center and mask-api query) + src_ip for unknown senders.

loki.source.syslog "lan" {
  listener {
    address       = "0.0.0.0:514"
    protocol      = "udp"
    syslog_format = "raw"
    labels        = { job = "syslog" }
  }
  listener {
    address       = "0.0.0.0:514"
    protocol      = "tcp"
    syslog_format = "raw"
    labels        = { job = "syslog" }
  }
  relabel_rules = loki.relabel.syslog.rules
  forward_to    = [loki.process.parse.receiver]
}

loki.relabel "syslog" {
  forward_to = []
  rule {
    source_labels = ["__syslog_message_severity"]
    target_label  = "severity"
  }
  rule {
    source_labels = ["__syslog_message_facility"]
    target_label  = "facility"
  }
  // temporary labels for the host decision; dropped again in loki.process "finalize"
  rule {
    source_labels = ["__syslog_connection_ip_address"]
    target_label  = "src_addr"
  }
  rule {
    source_labels = ["__syslog_connection_hostname"]
    target_label  = "src_name"
  }
}

loki.process "parse" {
  forward_to = [hostmap.hostmap.inventory.receiver]

  stage.replace {
    expression = "([\\r\\n]+)$"
    replace    = ""
  }
  // RFC5424: VERSION TIMESTAMP HOSTNAME APP-NAME PROCID MSGID STRUCTURED-DATA [MSG]
  stage.regex {
    expression = "^1 (?P<ts5>\\S+) (?P<host5>\\S+) (?P<app5>\\S+) (?P<proc5>\\S+) \\S+ (?:-|(?:\\[(?:[^\\]\"\\\\]|\\\\.|\"(?:[^\"\\\\]|\\\\.)*\")*\\])+)(?: (?P<msg5>.*))?$"
  }
  // RFC3164: "Mmm dd hh:mm:ss HOSTNAME MSG" (day space-padded); the tag, if any, stays part of the message
  stage.regex {
    expression = "^(?P<ts3>[A-Z][a-z]{2} [ 0-3][0-9] [0-9]{2}:[0-9]{2}:[0-9]{2}) (?P<host3>\\S+) (?P<msg3>.*)$"
  }
  stage.template {
    source   = "hdr_host"
    template = "{{ if .ts5 }}{{ if ne .host5 \"-\" }}{{ .host5 }}{{ end }}{{ else if .ts3 }}{{ .host3 }}{{ end }}"
  }
  stage.template {
    source   = "message"
    template = "{{ if .ts5 }}{{ if ne .app5 \"-\" }}{{ .app5 }}{{ if ne .proc5 \"-\" }}[{{ .proc5 }}]{{ end }}: {{ end }}{{ .msg5 }}{{ else if .ts3 }}{{ .msg3 }}{{ else }}{{ .Entry }}{{ end }}"
  }
  stage.labels {
    values = { hdr_host = "" }
  }
  stage.output {
    source = "message"
  }
}

// declare "hostmap" (one loki.relabel rule per inventory device), written by `tools targets`
import.file "hostmap" {
  filename = "/etc/obs-generated/alloy/hostmap.alloy"
}

hostmap.hostmap "inventory" {
  forward_to = [loki.process.finalize.receiver]
}

loki.process "finalize" {
  forward_to = [loki.write.local.receiver]

  stage.template {
    source   = "host"
    template = "{{ or .inv_host \"unknown\" }}"
  }
  // header hostname: dropped when it is the device's own name, otherwise kept as the first word of the message
  stage.template {
    source   = "message"
    template = "{{ if and .hdr_host (ne (ToLower .hdr_host) (ToLower .host)) }}{{ .hdr_host }} {{ end }}{{ .Entry }}"
  }
  stage.output {
    source = "message"
  }
  stage.template {
    source   = "drop_unknown"
    template = "{{ if not .inv_host }}" + sys.env("SYSLOG_DROP_UNKNOWN") + "{{ end }}"  // no inventory match
  }
  stage.drop {
    source = "drop_unknown"
    value  = "1"
  }
  stage.template {
    source   = "src_ip"
    template = "{{ if not .inv_host }}{{ .src_addr }}{{ end }}"
  }
  stage.labels {
    values = { host = "", src_ip = "" }
  }
  stage.label_drop {
    values = ["inv_host", "hdr_host", "src_name", "src_addr"]
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
